# Maw3ed.tn - Variables d'Environnement (exemple)
# Copier vers `.env` et adapter les valeurs locales.

# Base de données MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=maw3ed_db

# Sécurité JWT (Clé secrète HMAC-SHA256 >= 32 caractères en hexadécimal)
JWT_SECRET=replace_with_a_secure_64_char_hex_secret_key_for_production

# Microservice Python FastAPI (Triage Médical)
TRIAGE_SERVICE_URL=http://localhost:8000
